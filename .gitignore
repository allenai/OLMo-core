# slurm job logs: old sbatch launchers wrote hidden `.<family>_%x_%j.log` files to the repo root;
# those now live in /logs. Both patterns ignored so stale launchers don't re-clutter git status.
/logs/
/.*.log

# runtime artifacts: gantry scratch dir from launching at repo root; wrangler (viz site) cache
/train/
/.wrangler/

# local-only artifacts (never commit): preserved eval-score dumps + scratch configs
/eval_results_kept/
/configfile.txt

# eval launch ledger (run-evals / pull-evals skills): a local working record of what was
# launched and what has been pulled. The shared view of any eval is its row in ../results-hub;
# this is the bookkeeping behind it and doesn't belong in the history.
/records/eval_launches/

# Claude Code session/memory dir
.claude/

# The corpus-reasoning CODE lives in src/corpus_reasoning/ (tracked). The root clone was DELETED
# 2026-07-13 (its unique viz-hub work pushed to origin + vendored into src/corpus_reasoning/viz_hub/).
# This entry only guards against an accidental re-clone at the repo root.
/corpus-reasoning/

# repo-root symlink to src/scripts/train/memexpress (the training-code hub) for quick inspection
/training
