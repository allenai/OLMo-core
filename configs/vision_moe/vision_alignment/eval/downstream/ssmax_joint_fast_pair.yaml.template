      - {name: RESULTS_DIR, value: /results}
      - {name: GANTRY_RUNTIME_DIR, value: /gantry-runtime}
      - {name: GANTRY_EXEC_METHOD, value: exec}
      - {name: GANTRY_DEFAULT_PYTHON_VERSION, value: "3.12"}
      - {name: GANTRY_USE_SYSTEM_PYTHON, value: "1"}
      - {name: GANTRY_PYTHON_MANAGER, value: uv}
      - {name: GANTRY_UV_ALL_EXTRAS, value: "1"}
      - name: GANTRY_PRE_SETUP_CMD
        value: >-
          uv pip install --system "lmms-eval @
          git+https://github.com/EvolvingLMMs-Lab/lmms-eval.git@cb45ac4d4a667ea5ef89c7a148bff69b3489b981"
          datasets==3.6.0 pyarrow==19.0.1
      - {name: HF_HOME, value: /weka/oe-training-default/rustin/hf-cache}
      - {name: XDG_CACHE_HOME, value: /weka/oe-training-default/rustin/.cache/xdg}
      - {name: TMPDIR, value: /results/tmp}
      - {name: CUDA_CACHE_PATH, value: /weka/oe-training-default/rustin/.cache/cuda}
      - name: TORCHINDUCTOR_CACHE_DIR
        value: /weka/oe-training-default/rustin/.cache/torchinductor
      - {name: OLMO_TRITON_CACHE_BASE, value: /weka/oe-training-default/rustin/.cache/triton}
      - {name: TOKENIZERS_PARALLELISM, value: "false"}
      - {name: TORCH_LOGS, value: -dynamo}
      - {name: BEAKER_TOKEN, secret: RUSTINS_BEAKER_TOKEN}
    datasets:
      - mountPath: /gantry
        source: {beaker: 01KVV2DQHDQ4VRW0RHYWWHXW4M}
      - mountPath: /weka/oe-training-default
        source: {weka: oe-training-default}
    result:
      path: /results
    resources:
      gpuCount: 1
      sharedMemory: 32 GiB
    context:
      priority: urgent
      minRuntime: 8h0m0s
      autoResume: true
    constraints:
      cluster: [ai2/holmes]
    hostNetworking: false
    propagateFailure: false
