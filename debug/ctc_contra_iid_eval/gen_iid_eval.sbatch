#!/bin/bash
# Build a contradiction eval set that is IID with the CTC-suite training data.
#
# WHY. The CTC ladder trains on
#   contradiction_train_pubmed_realistic_n50-950_k3.jsonl   (mode=realistic, Qwen2.5-7B-Instruct)
# but is scored on the `both`-mode ladder (contradiction_clean). Measured gold-pair word-Jaccard:
#   train realistic 0.306   vs   eval both 0.375 (paper's eval: 0.385)
# -- different perturbation generators. The training run also emitted NO holdout: its log shows
#   TAG=full NUM_TRAIN=28000 POOL=40000 SEED=42 ... "Building eval n50-950 k3: 0it"
# i.e. --num-eval 0, and it exhausted the pair pool (28000 requested -> 20114 produced, ~28% lost
# to the validity filter). So the holdout has to be generated now, from the same generator and the
# same model, and then explicitly checked disjoint from the train file's gold sentences.
#
# MODEL. The train data was generated by a LOCAL vLLM serving Qwen/Qwen2.5-7B-Instruct on port
# 8766 (see gen_full/vllm_serve.log next to the train file) -- NOT gemini. Using a different
# generator LLM here would reintroduce exactly the mismatch we are removing.
#
# --max-overlap 0.5 IS NOT A GUESS. The train run's log records only TAG/NUM_TRAIN/POOL/SEED and its
# launcher is gone, so this flag had to be recovered from the data. The train file's gold-pair
# word-Jaccard distribution is:  median 0.306, mean 0.307, p90 0.459, p99 0.500, MAX 0.500, and
# exactly 0.000 of pairs above 0.5 -- a hard ceiling at the cap value, which is the signature of
# the realistic-mode near-duplicate backstop. A first run at the default --max-overlap 1.0 produced
# median 0.366 / mean 0.390 / p90 0.632 / max 1.000 with 20.6% of pairs above 0.5 (i.e. including
# near-verbatim "contradictions"), which is much closer to the `both` ladder it is meant to replace
# than to training. max_overlap DROPS the offending pair outright (no retry), so the cap acts as
# pure truncation and reproducing it reproduces the training distribution.
#
# --num-eval 2000 (was 1500): the cap rejects ~21% of pairs on top of the ~11% validity-filter loss
# and the ~19% disjointness drop measured below, so the candidate pool has to be wider to land 500.
#
# POOL. load_pubmed_pool() shuffles all PubMedQA indices with --seed and takes the first N, so a
# 40k pool is a subset of a 200k pool. The train run consumed ~60.3k claim sentences out of the
# 40k-abstract pool, leaving nothing behind. We widen to 200k abstracts so a fresh draw mostly
# misses the consumed set, then drop every example that still touches it. Expected survival is
# ~35-40%, hence --num-eval 1500 to land >=500.
#
# RUNGS. Base is generated at n=56 and expanded (LLM-free) to 92/187/379/762 -- the four upper
# rungs are byte-comparable in n to contradiction_clean, so dense/chunked numbers move ONLY
# because of the perturbation mode. n=56 replaces the old 2k rung n=44, which sat BELOW the
# training minimum (n=52) and was therefore extrapolation.
#SBATCH --job-name=contra-iid-gen
#SBATCH --account=site
#SBATCH --partition=jsteinhardt
#SBATCH --qos=preemptive_high
#SBATCH --gres=gpu:H200:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --time=06:00:00
#SBATCH --nodelist=mooney
#SBATCH --output=/data/prasann/joblogs/contra_iid_gen_%j.log
#SBATCH --chdir=/data/prasann
set -uo pipefail

# ---- node-local everything (NFS HOME/caches deadlock torch+vLLM; see local_cluster.md) ----
export HOME=/data/prasann/home
export HF_HOME=/data/prasann/hf_cache
# NOT offline: the Jun-29 cache holds the 15G of weights but never persisted config.json /
# tokenizer.json / merges.txt, so an offline load dies with "Invalid repository ID or local
# directory". Only the ~10MB of small files are fetched here; the weights are already local.
export HF_HUB_OFFLINE=0
export TRANSFORMERS_CACHE=/data/prasann/hf_cache
export TRITON_CACHE_DIR=/data/prasann/triton_cache
export FLASHINFER_CACHE_DIR=/data/prasann/flashinfer_cache
export TMPDIR=/data/prasann/tmp
export XDG_CACHE_HOME=/data/prasann/.cache
mkdir -p "$HOME" "$TMPDIR" "$XDG_CACHE_HOME" /data/prasann/joblogs

# vllm 0.25.1 JITs its flashinfer top-k/top-p sampler and dies with
#   RuntimeError: Could not find nvcc and default cuda_home='/usr/local/cuda' doesn't exist
# unless CUDA_HOME points at a real toolkit (the documented trap for this venv). Qwen2.5-7B is a
# plain dense model and the Jun-29 run served it on FLASH_ATTN, so we also just turn the flashinfer
# sampler off -- that removes the JIT from the path entirely rather than relying on the toolkit.
export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_ATTENTION_BACKEND=FLASH_ATTN
for c in /usr/local/cuda-12.8 /usr/local/cuda-12.9 /usr/local/cuda-12.6 /usr/local/cuda; do
  [ -x "$c/bin/nvcc" ] && export CUDA_HOME="$c" && break
done
[ -n "${CUDA_HOME:-}" ] && export PATH="$CUDA_HOME/bin:$PATH"
echo "[env] CUDA_HOME=${CUDA_HOME:-<none found>} flashinfer_sampler=off attn=$VLLM_ATTENTION_BACKEND"

WORK=/data/prasann/contra_iid_eval
GENSRC=/data/prasann/repo/OLMo-core/src            # in-tree corpus_reasoning (namespaced copy of
                                                   # the Jun-29 scratch generator; logic identical)
TRAIN=/data/prasann/single_task_ladders_20k/contradiction/gen_full/contradiction_train_pubmed_realistic_n50-950_k3.jsonl
SERVER_PY=/data/prasann/ctc_vllm_venv/bin/python   # node-local vLLM (0.25.1)
CLIENT_PY=/scratch/users/prasann/conda/envs/corpus-reasoning-eval/bin/python  # has openai+google-genai+datasets
PORT=8766
MODEL=Qwen/Qwen2.5-7B-Instruct
SERVED=Qwen2.5-7B-Instruct

mkdir -p "$WORK"/{raw,rungs,cache}
cd "$WORK"   # llm_request_client writes cache/response_cache.db relative to cwd -- a FRESH cache,
             # deliberately not the train run's, so nothing is silently reused.

echo "=== [contra-iid] HOST=$(hostname) START=$(date '+%F %T') ==="
[ -f "$TRAIN" ] || { echo "!!! train file missing: $TRAIN"; exit 1; }
[ -d "$GENSRC/corpus_reasoning" ] || { echo "!!! no in-tree corpus_reasoning at $GENSRC"; exit 1; }

# ---- 0. complete the model cache (small files only; 15G of weights already local) ----
echo "[0] ensuring config/tokenizer files are cached $(date '+%F %T')"
$CLIENT_PY - <<'PYEOF' || { echo "!!! could not complete the HF cache (no internet on this node?)"; exit 1; }
from huggingface_hub import snapshot_download
p = snapshot_download(
    "Qwen/Qwen2.5-7B-Instruct",
    allow_patterns=["*.json", "*.txt", "*.py"],   # config/tokenizer/generation only
)
print("snapshot:", p)
import os
missing = [f for f in ("config.json", "tokenizer_config.json") if not os.path.exists(os.path.join(p, f))]
raise SystemExit(1 if missing else 0)
PYEOF

# ---- 1. serve the SAME generator model the train data used ----
echo "[1] starting vLLM $MODEL on :$PORT $(date '+%F %T')"
$SERVER_PY -m vllm.entrypoints.openai.api_server \
  --model "$MODEL" --served-model-name "$SERVED" \
  --port $PORT --max-model-len 4096 --max-num-seqs 512 \
  --gpu-memory-utilization 0.85 \
  > "$WORK/vllm_serve.log" 2>&1 &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null' EXIT

for i in $(seq 1 120); do
  curl -sf "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1 && { echo "  server up after ${i}*5s"; break; }
  kill -0 $SERVER_PID 2>/dev/null || { echo "!!! server died, tail:"; tail -30 "$WORK/vllm_serve.log"; exit 1; }
  sleep 5
done
curl -sf "http://127.0.0.1:$PORT/v1/models" >/dev/null || { echo "!!! server never came up"; tail -30 "$WORK/vllm_serve.log"; exit 1; }

# ---- 2. generate the eval-only split, same flags as the train run ----
# --num-train 0 so the whole draw goes to eval; disjointness is enforced in step 3, not assumed.
echo "[2] generating eval base n=56 $(date '+%F %T')"
PYTHONPATH="$GENSRC" $CLIENT_PY "$GENSRC/corpus_reasoning/data/generate_pubmed_contradiction_data.py" \
  --num-docs 56 \
  --num-contradictions 3 \
  --mode realistic \
  --num-train 0 --num-eval 2000 \
  --pool-abstracts 200000 \
  --seed 42 \
  --max-overlap 0.5 \
  --model "$SERVED" \
  --base-url "http://127.0.0.1:$PORT/v1" \
  --max-concurrent 25 \
  --output-dir "$WORK/raw"
GEN_RC=$?
echo "[2] generator rc=$GEN_RC $(date '+%F %T')"
ls -la "$WORK/raw"

BASE_RAW="$WORK/raw/contradiction_eval_pubmed_realistic_n56_k3.jsonl"
[ -f "$BASE_RAW" ] || { echo "!!! generator produced no eval file"; exit 1; }

# ---- 3. enforce disjointness from the training gold sentences ----
echo "[3] disjointness filter vs train golds $(date '+%F %T')"
PYTHONPATH="$GENSRC" $CLIENT_PY "$GENSRC/../debug/ctc_contra_iid_eval/filter_disjoint.py" \
  --train "$TRAIN" \
  --eval-in "$BASE_RAW" \
  --eval-out "$WORK/raw/contra_iid_base500.jsonl" \
  --keep 500 \
  --report "$WORK/disjointness_report.json" || exit 1

# ---- 4. expand the SAME 500 examples up the ladder (no LLM) ----
for N in 92 187 379 762; do
  echo "[4] expanding to n=$N $(date '+%F %T')"
  PYTHONPATH="$GENSRC" $CLIENT_PY "$GENSRC/corpus_reasoning/data/generate_pubmed_contradiction_data.py" \
    --expand-from-eval "$WORK/raw/contra_iid_base500.jsonl" \
    --num-docs "$N" \
    --num-contradictions 3 \
    --mode realistic \
    --pool-abstracts 200000 \
    --seed 42 \
    --filler-pool-seed 43 \
    --output-dir "$WORK/raw" || echo "!!! expand n=$N FAILED"
done

# ---- 5. lay out as an eval_rungs/<task> dir the CTC drivers understand ----
echo "[5] assembling rung dir $(date '+%F %T')"
cp "$WORK/raw/contra_iid_base500.jsonl" "$WORK/rungs/rung_2560.jsonl"
for pair in "92:4096" "187:8192" "379:16384" "762:32768"; do
  N="${pair%%:*}"; R="${pair##*:}"
  SRC="$WORK/raw/contradiction_eval_pubmed_realistic_n${N}_k3.jsonl"
  [ -f "$SRC" ] && cp "$SRC" "$WORK/rungs/rung_${R}.jsonl" || echo "  MISSING n=$N -> rung_$R"
done
ls -la "$WORK/rungs"

# ---- 6. audit: sizes, token lengths, gold-pair Jaccard vs train ----
echo "[6] audit $(date '+%F %T')"
PYTHONPATH="$GENSRC" $CLIENT_PY "$GENSRC/../debug/ctc_contra_iid_eval/audit_iid_rungs.py" \
  --rung-dir "$WORK/rungs" --train "$TRAIN" --out "$WORK/iid_rung_audit.json"

echo "=== [contra-iid] DONE $(date '+%F %T') ==="
